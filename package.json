{
    "name": "flujo-de-fondos",
    "version": "1.0.0",
    "description": "",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build:backend": "cd Backend/flujodefondos && mvnw.cmd package -DskipTests -q && copy target\\flujodefondos.jar ..\\flujodefondos.jar",
        "build": "npm run build:backend && electron-builder"
    },
    "keywords": [],
    "author": "Axel Rullo",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@fontsource/dancing-script": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "electron-updater": "^6.8.9",
        "jsdom": "^30.1.2",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "tabulator-tables": "^6.6.1",
        "tom-select": "^2.6.2",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "electron": "^41.10.7",
        "electron-builder": "^26.15.7"
    },
    "build": {
        "appId": "com.axelrullo.flujo-de-fondos",
        "productName": "Flujo de Fondos",
        "files": [
            "main.js",
            "preload.js",
            "router.js",
            "index.html",
            "package.json",
            "Icons/**/*",
            "Profiles/**/*",
            "Scripts/**/*",
            "Styles/**/*",
            "Theme/**/*",
            "Views/**/*"
        ],
        "extraResources": [
            {
                "from": "Backend/flujodefondos.jar",
                "to": "Backend/flujodefondos.jar"
            },
            {
                "from": "Backend/jre",
                "to": "Backend/jre"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "Icons/logo.ico"
        },
        "mac": {
            "target": "dmg",
            "icon": "Icons/logo.png"
        },
                "linux": {
            "target": "AppImage",
            "icon": "Icons/logo.png"
        },
        "publish": {
            "provider": "github",
            "owner": "Axel-Rullo",
            "repo": "Flujo-de-Fondos"
        }
    },
    "allowScripts": {
        "electron@41.10.7": true
    }
}